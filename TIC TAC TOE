import random

# Display the board
def display_board(board):
    print("\n")
    print("-------------")
    for row in board:
        print("| " + " | ".join(row) + " |")
        print("-------------")


# Check if a player has won
def check_winner(board, player):
    # Rows
    for row in board:
        if all(cell == player for cell in row):
            return True

    # Columns
    for col in range(3):
        if all(board[row][col] == player for row in range(3)):
            return True

    # Diagonals
    if all(board[i][i] == player for i in range(3)):
        return True

    if all(board[i][2 - i] == player for i in range(3)):
        return True

    return False


# Check if board is full
def board_full(board):
    return all(cell != " " for row in board for cell in row)


# AI move
# Simple approach: choose a random empty position
def ai_move(board):
    empty_positions = []

    for i in range(3):
        for j in range(3):
            if board[i][j] == " ":
                empty_positions.append((i, j))

    if empty_positions:
        row, col = random.choice(empty_positions)
        board[row][col] = "O"
        print("AI chose:", row + 1, col + 1)


# Main game
def tic_tac_toe():

    board = [
        [" ", " ", " "],
        [" ", " ", " "],
        [" ", " ", " "]
    ]

    print("===== TIC-TAC-TOE =====")
    print("Player 1 = X")
    print("AI = O")

    while True:

        # -------------------------
        # PLAYER 1 TURN
        # -------------------------
        display_board(board)

        print("\nPlayer 1's turn")

        while True:
            try:
                row = int(input("Enter row (1-3): ")) - 1
                col = int(input("Enter column (1-3): ")) - 1

                if row not in range(3) or col not in range(3):
                    print("Enter values between 1 and 3.")
                    continue

                if board[row][col] != " ":
                    print("Position already occupied!")
                    continue

                board[row][col] = "X"
                break

            except ValueError:
                print("Please enter numbers only.")

        # Check Player 1 win
        if check_winner(board, "X"):
            display_board(board)
            print("\nPlayer 1 Wins!")
            break

        # Check draw
        if board_full(board):
            display_board(board)
            print("\nIt's a Draw!")
            break

        # -------------------------
        # AI TURN
        # -------------------------
        print("\nAI's turn...")
        ai_move(board)

        # Check AI win
        if check_winner(board, "O"):
            display_board(board)
            print("\nAI Wins!")
            break

        # Check draw
        if board_full(board):
            display_board(board)
            print("\nIt's a Draw!")
            break


# Start game
tic_tac_toe()




